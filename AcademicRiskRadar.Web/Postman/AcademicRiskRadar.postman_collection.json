    {
      "name": "Risk Engine API",
      "item": [
        {
          "name": "1. POST Calculate Real-time Risk Score",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"attendanceRate\": 52.0,\n  \"assessmentScore\": 48.0,\n  \"assignmentCompletionPercentage\": 40.0,\n  \"lmsActivityHours\": 9.5,\n  \"attendanceWeight\": 35,\n  \"assessmentWeight\": 30,\n  \"assignmentWeight\": 20,\n  \"lmsWeight\": 15\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/risk/calculate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "risk", "calculate"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Calculates High/Critical Risk\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.riskScore).to.be.above(50);",
                  "});"
                ]
              }
            }
          ]
        },
