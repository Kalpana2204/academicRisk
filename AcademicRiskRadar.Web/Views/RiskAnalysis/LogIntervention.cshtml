@model AcademicRiskRadar.Web.Models.MentoringInterventionEntity

@{
    ViewData["Title"] = $"Schedule Mentoring Intervention: {Model.StudentName}";
    var student = ViewBag.Student as AcademicRiskRadar.Web.Models.StudentEntity;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-shadow p-4">
            <h3 class="fw-bold mb-1">Schedule Mentoring Intervention</h3>
            <p class="text-muted small">Record academic mentoring actions and notifications for at-risk students.</p>

            @if (student != null)
            {
                <div class="alert alert-light border p-3 mb-3 small">
                    <div><strong>Student:</strong> @student.Name (<code>@student.StudentCode</code>)</div>
                    <div><strong>Current Attendance:</strong> @student.AttendanceRate% | <strong>Risk:</strong> @student.Risk (@student.ComputedRiskScore%)</div>
                    <div><strong>Assigned Mentor:</strong> @student.MentorName</div>
                </div>
            }

            <form asp-action="LogIntervention" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="StudentId" />
                <input type="hidden" asp-for="StudentName" />
                <input type="hidden" asp-for="MentorName" />

                <div class="mb-3">
                    <label asp-for="ActionType" class="form-label fw-bold">Intervention Action</label>
                    <select asp-for="ActionType" class="form-select">
                        <option value="Counseling Session">1-on-1 Counseling Session</option>
                        <option value="Remedial Classes">Remedial / Tutoring Classes</option>
                        <option value="Parent Notification">Parent Academic Notification</option>
                        <option value="Attendance Warning Letter">Official Attendance Warning</option>
                        <option value="Dean Referral">Dean / HOD Disciplinary Referral</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Status" class="form-label fw-bold">Initial Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Scheduled">Scheduled</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Completed">Completed</option>
                        <option value="Follow-up Required">Follow-up Required</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label fw-bold">Mentoring Notes & Observations</label>
                    <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Detail action points, agreed study schedule, root causes..."></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="Students" asp-action="Details" asp-route-id="@Model.StudentId" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-warning fw-bold text-dark px-4">
                        Save Mentoring Record &rarr;
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
