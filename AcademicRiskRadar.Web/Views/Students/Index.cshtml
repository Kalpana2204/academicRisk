@model IEnumerable<AcademicRiskRadar.Web.Models.StudentEntity>

@{
    bool isStudent = User.IsInRole("Student") || ViewBag.IsStudentRole == true;
    ViewData["Title"] = isStudent ? "My Student Academic Record" : "Student Records & Performance Directory";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">@(isStudent ? "My Academic Record & Performance Scorecard" : "Student Performance Directory")</h2>
        <p class="text-muted mb-0">
            @if (isStudent)
            {
                <span>Personal Student Record &bull; <strong>@ViewData["CurrentTerm"]</strong> &bull; Official Academic Standing</span>
            }
            else
            {
                <span>Institutional Cohort &bull; <strong>@ViewData["CurrentTerm"]</strong> &bull; Showing <strong>@Model.Count()</strong> of <strong>@ViewBag.TotalCount</strong> registered students</span>
            }
        </p>
    </div>
    @if (!isStudent)
    {
        <div class="mt-2 mt-md-0 d-flex gap-2">
            <a asp-action="Create" class="btn btn-pro-primary">
                + Register New Student
            </a>
        </div>
    }
</div>

@if (!isStudent)
{
    <!-- Search & Filtering Form (Faculty and Admin Only) -->
    <div class="pro-card p-3 mb-4">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Department</label>
                <select name="department" class="form-select form-select-sm rounded-3">
                    <option value="">All Departments</option>
                    @foreach (var dept in (string[])ViewBag.Departments)
                    {
                        <option value="@dept" selected="@(ViewBag.SelectedDepartment == dept)">@dept</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Risk Category</label>
                <select name="risk" class="form-select form-select-sm rounded-3">
                    <option value="">All Risk Levels</option>
                    <option value="Low" selected="@(ViewBag.SelectedRisk?.ToString() == "Low")">Low Risk</option>
                    <option value="Moderate" selected="@(ViewBag.SelectedRisk?.ToString() == "Moderate")">Moderate Risk</option>
                    <option value="High" selected="@(ViewBag.SelectedRisk?.ToString() == "High")">High Risk</option>
                    <option value="Critical" selected="@(ViewBag.SelectedRisk?.ToString() == "Critical")">Critical Risk</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Search Student</label>
                <input type="text" name="search" value="@ViewBag.SearchTerm" placeholder="Search by name, code or email..." class="form-control form-control-sm rounded-3" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted">Sort By</label>
                <select name="sortBy" class="form-select form-select-sm rounded-3">
                    <option value="risk_desc" selected="@(ViewBag.SortBy == "risk_desc")">Risk: High to Low</option>
                    <option value="risk_asc" selected="@(ViewBag.SortBy == "risk_asc")">Risk: Low to High</option>
                    <option value="attendance_asc" selected="@(ViewBag.SortBy == "attendance_asc")">Attendance: Lowest</option>
                    <option value="attendance_desc" selected="@(ViewBag.SortBy == "attendance_desc")">Attendance: Highest</option>
                    <option value="name" selected="@(ViewBag.SortBy == "name")">Student Name</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-dark btn-sm w-100 rounded-3 fw-semibold">Filter</button>
            </div>
        </form>
    </div>
}

<!-- Student Grid Table -->
<div class="pro-card overflow-hidden">
    <div class="table-responsive">
        <table class="table pro-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Student Profile</th>
                    <th>Academic Program</th>
                    <th>Attendance</th>
                    <th>Assessment</th>
                    <th>Coursework</th>
                    <th>Calculated Risk</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            No student records found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var student in Model)
                    {
                        var riskClass = student.Risk switch
                        {
                            AcademicRiskRadar.Web.Models.RiskLevel.Critical => "critical",
                            AcademicRiskRadar.Web.Models.RiskLevel.High => "high",
                            AcademicRiskRadar.Web.Models.RiskLevel.Moderate => "moderate",
                            _ => "low"
                        };

                        var initials = string.Join("", student.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0])).ToUpperInvariant();
                        if (initials.Length > 2) initials = initials[..2];

                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="student-avatar">@initials</div>
                                    <div>
                                        <div class="fw-bold text-dark">@student.Name</div>
                                        <div class="text-muted small">
                                            <span class="badge bg-light text-secondary border">@student.StudentCode</span>
                                            <span>@student.Email</span>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div><strong>@student.Department</strong> &bull; Sem @student.Semester (Sec @student.Section)</div>
                                <div class="text-muted small">Mentor: @(string.IsNullOrEmpty(student.MentorName) ? "Department Faculty Advisor" : student.MentorName)</div>
                            </td>
                            <td>
                                <div class="fw-bold @(student.AttendanceRate < 75 ? "text-danger" : "text-success")">
                                    @student.AttendanceRate.ToString("F1")%
                                </div>
                                <div class="progress-thin mt-1" style="width: 80px;">
                                    <div class="progress-bar @(student.AttendanceRate < 75 ? "bg-danger" : "bg-success")"
                                         style="width: @student.AttendanceRate%"></div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold @(student.AssessmentScore < 60 ? "text-danger" : "text-dark")">
                                    @student.AssessmentScore.ToString("F1")%
                                </div>
                                <div class="progress-thin mt-1" style="width: 80px;">
                                    <div class="progress-bar @(student.AssessmentScore < 60 ? "bg-warning" : "bg-info")"
                                         style="width: @student.AssessmentScore%"></div>
                                </div>
                            </td>
                            <td>
                                <div class="small">
                                    <strong>@student.SubmittedAssignments</strong> / @student.TotalAssignments
                                    <span class="text-muted">(@student.AssignmentCompletionPercentage.ToString("F0")%)</span>
                                </div>
                            </td>
                            <td>
                                <span class="risk-pill @riskClass">
                                    @student.Risk (@student.ComputedRiskScore.ToString("F1")%)
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-outline-primary rounded-pill px-3">View Full Scorecard</a>
                                    @if (!isStudent)
                                    {
                                        <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-outline-secondary ms-1 rounded-pill px-2">Edit</a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-outline-danger ms-1 rounded-pill px-2">Delete</a>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
