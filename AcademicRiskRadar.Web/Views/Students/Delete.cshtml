@model AcademicRiskRadar.Web.Models.StudentEntity

@{
    ViewData["Title"] = $"Delete Student: {Model.Name}";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-shadow border-danger border-top border-4 p-4 text-center">
            <div class="text-danger display-4 mb-2">⚠️</div>
            <h3 class="fw-bold text-danger">Confirm Student Deletion</h3>
            <p class="text-muted">
                Are you sure you want to permanently delete student <strong>@Model.Name</strong> (<code>@Model.StudentCode</code>)?
                This action cannot be undone.
            </p>

            <div class="p-3 bg-light rounded text-start my-3 small">
                <div><strong>Department:</strong> @Model.Department</div>
                <div><strong>Program:</strong> @Model.Program</div>
                <div><strong>Current Attendance:</strong> @Model.AttendanceRate%</div>
                <div><strong>Current Risk:</strong> @Model.Risk (@Model.ComputedRiskScore%)</div>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex justify-content-center gap-2">
                @Html.AntiForgeryToken()
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-danger fw-bold px-4">
                    Yes, Delete Student Record
                </button>
            </form>
        </div>
    </div>
</div>
