@{
    ViewData["Title"] = "Security Pipeline, Middleware & Dependency Diagnostics";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Platform Architecture</a></li>
            <li class="breadcrumb-item active" aria-current="page">Security &amp; Middleware</li>
        </ol>
    </nav>
    <h2 class="fw-bold mb-1">Security Pipeline, Middleware &amp; Dependency Diagnostics</h2>
    <p class="text-muted">Middleware request pipelines, Dependency Injection lifetimes, Code-First vs Database-First, and Role Security.</p>
</div>

<!-- Section 1: Middleware Pipeline Visualizer -->
<div class="card card-shadow p-4 mb-4">
    <h4 class="fw-bold text-primary mb-3">1. Middleware Request Pipeline Architecture</h4>
    <p>
        In ASP.NET Core, incoming HTTP requests flow through a sequence of <strong>Middleware delegates</strong>. 
        Each component can perform logic before and after the next delegate, or short-circuit the pipeline entirely.
    </p>

    <div class="bg-dark text-light p-3 rounded font-monospace small mb-3">
        HTTP Request &rarr;<br />
        &nbsp;&nbsp;[ ExceptionHandler Middleware ] &rarr;<br />
        &nbsp;&nbsp;[ HSTS &amp; HttpsRedirection Middleware ] &rarr;<br />
        &nbsp;&nbsp;[ StaticFiles Middleware (Serves .css, .js, images) ] &rarr;<br />
        &nbsp;&nbsp;[ Routing Middleware (Matches URL to endpoint) ] &rarr;<br />
        &nbsp;&nbsp;[ Custom RequestExecutionTimingMiddleware ] &rarr; (Calculates execution time in ms)<br />
        &nbsp;&nbsp;[ Session Middleware ] &rarr;<br />
        &nbsp;&nbsp;[ Authentication Middleware (Extracts Claims from Cookie) ] &rarr;<br />
        &nbsp;&nbsp;[ Authorization Middleware (Enforces [Authorize(Roles=...)]) ] &rarr;<br />
        &nbsp;&nbsp;[ Custom AcademicSecurityAuditMiddleware ] &rarr;<br />
        &nbsp;&nbsp;&nbsp;&nbsp;&rarr; [ MVC Controller / Web API Action Execution ] &larr;<br />
        &nbsp;&nbsp;&larr; Outgoing HTTP Response (Headers &amp; Body returned to browser)
    </div>

    <h6 class="fw-bold">Recent Audit Logs Captured by Custom Security Middleware:</h6>
    <div class="table-responsive small">
        <table class="table table-sm table-striped">
            <thead class="table-light"><tr><th>Timestamp</th><th>Method</th><th>Path</th><th>Status</th><th>IP</th><th>User Identity</th><th>Role</th></tr></thead>
            <tbody>
                @foreach (var log in (IEnumerable<AcademicRiskRadar.Web.Models.AuditLogEntry>)ViewBag.AuditLogs)
                {
                    <tr>
                        <td>@log.Timestamp.ToString("HH:mm:ss")</td>
                        <td><code>@log.HttpMethod</code></td>
                        <td>@log.Path</td>
                        <td><span class="badge @(log.StatusCode == 200 ? "bg-success" : "bg-warning text-dark")">@log.StatusCode</span></td>
                        <td>@log.ClientIp</td>
                        <td>@log.UserIdentity</td>
                        <td><span class="badge bg-secondary">@log.Role</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Section 2: Dependency Injection Lifetimes Live Tester -->
<div class="card card-shadow p-4 mb-4 border-start border-4 border-success">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-success mb-0">2. Dependency Injection (DI) Lifetimes Live Inspector</h4>
        <a asp-action="Unit4" class="btn btn-outline-success btn-sm fw-bold">🔄 Refresh Request (Observe GUID Changes)</a>
    </div>
    <p class="text-muted small">
        ASP.NET Core provides three distinct service lifetimes. Below are the live GUID instance identifiers 
        resolved during THIS current HTTP request:
    </p>

    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Lifetime</th>
                    <th>Direct Injected GUID</th>
                    <th>Injected inside Service GUID</th>
                    <th>Behavior Analysis</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong class="text-danger">Transient</strong><br /><small class="text-muted">AddTransient&lt;T&gt;()</small></td>
                    <td><code class="text-danger">@ViewBag.DirectTransient</code></td>
                    <td><code class="text-danger">@ViewBag.ServiceTransient</code></td>
                    <td><span class="badge bg-danger">Different GUIDs</span><br /><small class="text-muted">A brand new instance is instantiated every time it is requested.</small></td>
                </tr>
                <tr>
                    <td><strong class="text-primary">Scoped</strong><br /><small class="text-muted">AddScoped&lt;T&gt;()</small></td>
                    <td><code class="text-primary">@ViewBag.DirectScoped</code></td>
                    <td><code class="text-primary">@ViewBag.ServiceScoped</code></td>
                    <td><span class="badge bg-primary">Identical GUIDs</span><br /><small class="text-muted">Same instance shared across the entire HTTP request scope.</small></td>
                </tr>
                <tr>
                    <td><strong class="text-success">Singleton</strong><br /><small class="text-muted">AddSingleton&lt;T&gt;()</small></td>
                    <td><code class="text-success">@ViewBag.DirectSingleton</code></td>
                    <td><code class="text-success">@ViewBag.ServiceSingleton</code></td>
                    <td><span class="badge bg-success">Never Changes</span><br /><small class="text-muted">Single instance shared globally across all users and all requests.</small></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Section 3: Code First vs Database First Approaches -->
<div class="card card-shadow p-4 mb-4">
    <h4 class="fw-bold text-primary mb-3">3. Developing Applications: Code-First vs Database-First Approaches</h4>
    <div class="row g-4">
        <div class="col-md-6">
            <div class="p-3 bg-light rounded border h-100">
                <h5 class="fw-bold text-primary">A. Code-First Approach</h5>
                <p class="small text-muted">
                    Developers write C# entity model classes first. Entity Framework Core generates and evolves the database schema using migrations.
                </p>
                <div class="bg-white p-2 rounded border small font-monospace mb-2">
                    # 1. Add Migration based on C# Models<br />
                    dotnet ef migrations add InitialCreate<br /><br />
                    # 2. Apply Migration to SQL Server<br />
                    dotnet ef database update
                </div>
                <span class="badge bg-primary">Best for DDD &amp; Greenfield Applications</span>
            </div>
        </div>

        <div class="col-md-6">
            <div class="p-3 bg-light rounded border h-100">
                <h5 class="fw-bold text-success">B. Database-First Approach</h5>
                <p class="small text-muted">
                    The database schema already exists in SQL Server. EF Core reverse-engineers C# POCO classes and DbContext from the existing schema.
                </p>
                <div class="bg-white p-2 rounded border small font-monospace mb-2">
                    # Scaffold C# models from existing SQL Server DB<br />
                    dotnet ef dbcontext scaffold "Server=localhost;Database=AcademicRiskRadarDB;..." Microsoft.EntityFrameworkCore.SqlServer -o Models/DbFirst
                </div>
                <span class="badge bg-success">Best for Legacy Databases &amp; DBA Governance</span>
            </div>
        </div>
    </div>
</div>

<!-- Section 4: Authentication & Authorization -->
<div class="card card-shadow p-4">
    <h4 class="fw-bold text-primary mb-3">4. Authentication and Authorization in Web Applications</h4>
    <p>
        Security is managed using <strong>ASP.NET Core Cookie Authentication</strong> with <strong>Claims-Based Roles</strong>.
    </p>

    <div class="table-responsive">
        <table class="table table-bordered table-sm">
            <thead class="table-light"><tr><th>Role</th><th>Privileges & Authorization Policy</th><th>Guarded Action Example</th></tr></thead>
            <tbody>
                <tr>
                    <td><strong class="text-danger">Admin</strong></td>
                    <td>Full administrative rights: Register students, edit profiles, delete students, view SQL Studio.</td>
                    <td><code>[Authorize(Roles = "Admin")]</code> on <code>StudentsController.Delete</code></td>
                </tr>
                <tr>
                    <td><strong class="text-primary">Faculty</strong></td>
                    <td>Academic mentor rights: Register new students, update performance, schedule interventions.</td>
                    <td><code>[Authorize(Roles = "Admin,Faculty")]</code> on <code>StudentsController.Create</code></td>
                </tr>
                <tr>
                    <td><strong class="text-success">Student</strong></td>
                    <td>Read-only student access to personal radar profile, courses, and educational labs.</td>
                    <td><code>[Authorize]</code> on profile view</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm">
            Test Authentication & Role Switcher &rarr;
        </a>
    </div>
</div>
