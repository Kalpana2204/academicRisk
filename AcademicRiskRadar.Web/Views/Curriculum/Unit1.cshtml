<!-- Section 2: .NET Core vs .NET Framework -->
<div class="card card-shadow p-4 mb-4">
    <h4 class="fw-bold text-primary mb-3">2. Difference Between .NET Framework and .NET Core</h4>
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Feature</th>
                    <th>.NET Framework (Legacy)</th>
                    <th>.NET Core / Modern .NET (.NET 5+)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Operating System</strong></td>
                    <td>Windows only</td>
                    <td><span class="badge bg-success">Cross-Platform</span> (Windows, Linux, macOS)</td>
                </tr>
                <tr>
                    <td><strong>Architecture</strong></td>
                    <td>Monolithic system-wide installation (GAC)</td>
                    <td>Modular NuGet packages & self-contained runtime</td>
                </tr>
                <tr>
                    <td><strong>Performance</strong></td>
                    <td>Moderate</td>
                    <td><span class="badge bg-primary">Extremely High</span> (Vectorization, Span&lt;T&gt;, RyuJIT)</td>
                </tr>
                <tr>
                    <td><strong>Runtime Engine</strong></td>
                    <td>CLR (Common Language Runtime)</td>
                    <td>CoreCLR (Modern, high-efficiency runtime)</td>
                </tr>
                <tr>
                    <td><strong>Source Code</strong></td>
                    <td>Proprietary (Reference source only)</td>
                    <td><span class="badge bg-info text-dark">100% Open Source</span> on GitHub</td>
                </tr>
                <tr>
                    <td><strong>Deployment</strong></td>
                    <td>Machine-wide; risk of DLL hell</td>
                    <td>Side-by-side versions & Self-contained single-file publish</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

