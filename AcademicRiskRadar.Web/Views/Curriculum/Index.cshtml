@{
    ViewData["Title"] = "Platform Architecture & Engineering Hub";
}

<div class="mb-4">
    <div class="pro-card p-4 bg-white">
        <h2 class="fw-bold mb-2">🏛️ Platform Architecture &amp; Engineering Hub</h2>
        <p class="text-muted mb-0 lead" style="font-size: 1.05rem;">
            Enterprise architectural blueprint of the Academic Risk Radar platform: .NET 10 LTS CoreCLR, 
            Domain OOP calculation engines, MVC state management pipelines, security operations, relational SQL databases, and RESTful APIs.
        </p>
    </div>
</div>

<div class="row g-4">
    <!-- Module 1 Card -->
    <div class="col-md-6 col-lg-4">
        <div class="pro-card pro-card-hover h-100 p-4 border-top border-4 border-primary d-flex flex-column">
            <span class="badge bg-primary bg-opacity-10 text-primary w-auto align-self-start mb-2 px-3 py-1 rounded-pill">Platform Runtime</span>
            <h5 class="fw-bold">Runtime &amp; Execution Pipeline</h5>
            <ul class="text-muted small ps-3 mb-4">
                <li>ASP.NET Core architecture &amp; version roadmap</li>
                <li>Modern CoreCLR vs legacy .NET Framework</li>
                <li>VS Code development environment configuration</li>
                <li>.NET CLI toolchain cheatsheet</li>
                <li>Roslyn compiler &amp; RyuJIT execution pipeline</li>
            </ul>
            <div class="mt-auto">
                <a asp-action="Unit1" class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-semibold">Open Runtime Hub &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Module 2 Card -->
    <div class="col-md-6 col-lg-4">
        <div class="pro-card pro-card-hover h-100 p-4 border-top border-4 border-success d-flex flex-column">
            <span class="badge bg-success bg-opacity-10 text-success w-auto align-self-start mb-2 px-3 py-1 rounded-pill">Computation</span>
            <h5 class="fw-bold">Academic Calculation Engine &amp; OOP</h5>
            <ul class="text-muted small ps-3 mb-4">
                <li>Variables, Value Types vs Reference Types</li>
                <li>Operator precedence &amp; evaluation hierarchy</li>
                <li>Pattern-matching conditional branching</li>
                <li>Iteration loops &amp; jump statements</li>
                <li>1D, 2D Rectangular &amp; Jagged array processing</li>
                <li>Strings immutability &amp; StringBuilder</li>
                <li>OOP Hierarchy: Encapsulation, Polymorphism, Abstraction</li>
                <li>Structured exception handling pipeline</li>
            </ul>
            <div class="mt-auto">
                <a asp-action="Unit2" class="btn btn-outline-success btn-sm w-100 rounded-pill fw-semibold">Run Calculation Lab &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Module 3 Card -->
    <div class="col-md-6 col-lg-4">
        <div class="pro-card pro-card-hover h-100 p-4 border-top border-4 border-info d-flex flex-column">
            <span class="badge bg-info bg-opacity-10 text-primary w-auto align-self-start mb-2 px-3 py-1 rounded-pill">Backend MVC</span>
            <h5 class="fw-bold">MVC Architecture &amp; State Pipeline</h5>
            <ul class="text-muted small ps-3 mb-4">
                <li>Enterprise folder structure &amp; hosting lifecycle</li>
                <li>Model-View-Controller decoupled communication</li>
                <li>HTTP Action Results &amp; request handling</li>
                <li>Razor View Engine, Layouts &amp; Sections</li>
                <li>State passing: ViewBag, ViewData, TempData, Session, QueryString</li>
                <li>Strongly-typed forms &amp; server/client validation</li>
            </ul>
            <div class="mt-auto">
                <a asp-action="Unit3" class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-semibold">Inspect State Pipeline &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Module 4 Card -->
    <div class="col-md-6 col-lg-4">
        <div class="pro-card pro-card-hover h-100 p-4 border-top border-4 border-warning d-flex flex-column">
            <span class="badge bg-warning bg-opacity-20 text-dark w-auto align-self-start mb-2 px-3 py-1 rounded-pill">Security &amp; Pipeline</span>
            <h5 class="fw-bold">Security, Middleware &amp; DI Lifetimes</h5>
            <ul class="text-muted small ps-3 mb-4">
                <li>HTTP Request Middleware Pipeline architecture</li>
                <li>Custom execution timing &amp; security audit middleware</li>
                <li>Dependency Injection: Transient, Scoped, Singleton live inspector</li>
                <li>Code-First vs Database-First architectural approaches</li>
                <li>Cookie authentication &amp; role-based access control</li>
            </ul>
            <div class="mt-auto">
                <a asp-action="Unit4" class="btn btn-outline-warning text-dark btn-sm w-100 rounded-pill fw-semibold">Inspect Security Engine &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Module 5 Card -->
    <div class="col-md-6 col-lg-4">
        <div class="pro-card pro-card-hover h-100 p-4 border-top border-4 border-danger d-flex flex-column">
            <span class="badge bg-danger bg-opacity-10 text-danger w-auto align-self-start mb-2 px-3 py-1 rounded-pill">Database Layer</span>
            <h5 class="fw-bold">Relational Database &amp; SQL Schema</h5>
            <ul class="text-muted small ps-3 mb-4">
                <li>Enterprise database architecture &amp; SQL Server</li>
                <li>T-SQL commands (DDL, DML, DQL, DCL, TCL)</li>
                <li>Schema tables, primary keys, foreign keys &amp; CHECK constraints</li>
                <li>SQL Clauses (WHERE, GROUP BY, HAVING, ORDER BY)</li>
                <li>Relational Joins (Inner, Left, Right, Full)</li>
                <li>Analytical Views &amp; Stored Procedures</li>
            </ul>
            <div class="mt-auto">
                <a asp-action="Unit5" class="btn btn-outline-danger btn-sm w-100 rounded-pill fw-semibold">Open Database Hub &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Module 6 Card -->
    <div class="col-md-6 col-lg-4">
        <div class="pro-card pro-card-hover h-100 p-4 border-top border-4 border-secondary d-flex flex-column">
            <span class="badge bg-secondary bg-opacity-10 text-secondary w-auto align-self-start mb-2 px-3 py-1 rounded-pill">Developer API</span>
            <h5 class="fw-bold">REST API Gateway &amp; Postman</h5>
            <ul class="text-muted small ps-3 mb-4">
                <li>REST architectural principles &amp; HTTP verbs</li>
                <li>ASP.NET Web API controllers &amp; JSON serialization</li>
                <li>Full CRUD operations (GET, POST, PUT, DELETE)</li>
                <li>Attribute Routing vs Convention Routing</li>
                <li>Postman testing collection with pre-scripted assertions</li>
            </ul>
            <div class="mt-auto">
                <a asp-action="Unit6" class="btn btn-outline-secondary btn-sm w-100 rounded-pill fw-semibold">Open API Gateway &rarr;</a>
            </div>
        </div>
    </div>
</div>
