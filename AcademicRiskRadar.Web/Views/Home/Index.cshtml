@using AcademicRiskRadar.Web.Models
@{
    bool isStudent = ViewBag.IsStudent == true && ViewBag.CurrentStudent != null;
    StudentEntity? me = isStudent ? (StudentEntity)ViewBag.CurrentStudent : null;
    ViewData["Title"] = isStudent ? "My Academic Portal & Performance Scorecard" : "Executive Overview & Academic Intelligence";
    int total = ViewBag.TotalStudents ?? 6;
    int highRisk = ViewBag.HighRiskCount ?? 3;
    int interventions = ViewBag.TotalInterventions ?? 3;
}

@if (isStudent && me != null)
{
    <!-- ========================================== -->
    <!-- STUDENT PERSONALIZED PORTAL & SCORECARD   -->
    <!-- ========================================== -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="p-4 p-lg-5 pro-hero">
                <div class="d-flex flex-wrap justify-content-between align-items-center position-relative" style="z-index: 1;">
                    <div class="mb-3 mb-md-0">
                        <div class="d-inline-flex align-items-center bg-white bg-opacity-20 px-3 py-1 rounded-pill small mb-3">
                            <span class="badge bg-success rounded-circle p-1 me-2" style="width: 8px; height: 8px;"></span>
                            <span class="text-white fw-semibold">Personalized Student Portal &bull; Academic Year 2026–27</span>
                        </div>
                        <h1 class="display-6 fw-bold mb-2">Welcome, @me.Name!</h1>
                        <p class="lead mb-0 text-white-50" style="max-width: 680px;">
                            <strong>Roll ID:</strong> @me.StudentCode &bull; <strong>Department:</strong> @me.Department &bull;
                            <strong>Program:</strong> @me.Program &bull; <strong>Semester:</strong> @me.Semester (Section @me.Section)
                        </p>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Students" asp-action="Details" asp-route-id="@me.Id" class="btn btn-light fw-bold px-4 py-2 rounded-3 shadow-sm">
                            View Full Scorecard &rarr;
                        </a>
                        <a asp-controller="Students" asp-action="Index" class="btn btn-outline-light fw-semibold px-4 py-2 rounded-3">
                            My Student Record
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Student Individual Academic KPIs -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card pro-card-hover">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small text-uppercase fw-bold">My Attendance Rate</span>
                    <div class="kpi-icon-wrap bg-primary bg-opacity-10 text-primary">📅</div>
                </div>
                <div class="kpi-value @(me.AttendanceRate < 75 ? "text-danger" : "text-success") mb-1">
                    @me.AttendanceRate.ToString("F1")%
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="kpi-trend @(me.AttendanceRate < 75 ? "bg-danger bg-opacity-10 text-danger" : "bg-success bg-opacity-10 text-success")">
                        @(me.AttendanceRate >= 75 ? "Requirement Met" : "Below 75% Threshold")
                    </span>
                    <span class="text-muted small">Current term</span>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card pro-card-hover">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small text-uppercase fw-bold">My Assessment Score</span>
                    <div class="kpi-icon-wrap bg-info bg-opacity-10 text-info">📝</div>
                </div>
                <div class="kpi-value text-dark mb-1">@me.AssessmentScore.ToString("F1")%</div>
                <div class="d-flex align-items-center gap-2">
                    <span class="kpi-trend @(me.AssessmentScore >= 60 ? "bg-success bg-opacity-10 text-success" : "bg-warning bg-opacity-10 text-warning")">
                        @(me.AssessmentScore >= 60 ? "Satisfactory" : "Review Recommended")
                    </span>
                    <span class="text-muted small">Internal tests</span>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card pro-card-hover">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small text-uppercase fw-bold">Coursework Progress</span>
                    <div class="kpi-icon-wrap bg-warning bg-opacity-10 text-warning">📚</div>
                </div>
                <div class="kpi-value text-dark mb-1">@me.SubmittedAssignments / @me.TotalAssignments</div>
                <div class="d-flex align-items-center gap-2">
                    <span class="kpi-trend bg-primary bg-opacity-10 text-primary">@me.AssignmentCompletionPercentage.ToString("F0")% Completed</span>
                    <span class="text-muted small">Assignments</span>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card pro-card-hover">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small text-uppercase fw-bold">My Academic Risk Status</span>
                    <div class="kpi-icon-wrap bg-success bg-opacity-10 text-success">🛡️</div>
                </div>
                <div class="kpi-value @(me.Risk == RiskLevel.Low ? "text-success" : me.Risk == RiskLevel.Moderate ? "text-warning" : "text-danger") mb-1">
                    @me.Risk Risk
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="kpi-trend bg-light text-secondary border">Index: @me.ComputedRiskScore.ToString("F1")%</span>
                    <span class="text-muted small">@(me.Risk == RiskLevel.Low ? "Good standing" : "Advisory active")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Student Courses & Academic Standing -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="pro-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-1">My Enrolled Courses &amp; Progress</h5>
                        <p class="text-muted small mb-0">Registered courses for Semester @me.Semester &bull; Attendance and internal continuous assessment marks</p>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table pro-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Course Code</th>
                                <th>Course Title</th>
                                <th>Credits</th>
                                <th>My Attendance</th>
                                <th>Assessment Marks</th>
                                <th>Academic Standing</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (me.Courses.Any())
                            {
                                @foreach (var c in me.Courses)
                                {
                                    <tr>
                                        <td><span class="badge bg-light text-secondary border">@c.CourseCode</span></td>
                                        <td class="fw-semibold text-dark">@c.CourseName</td>
                                        <td>@c.Credits Credits</td>
                                        <td>
                                            <span class="fw-bold @(c.AttendanceRate < 75 ? "text-danger" : "text-success")">@c.AttendanceRate%</span>
                                        </td>
                                        <td>
                                            <span class="fw-bold @(c.MarksObtained < 60 ? "text-warning" : "text-dark")">@c.MarksObtained%</span>
                                        </td>
                                        <td>
                                            @if (c.AttendanceRate >= 75 && c.MarksObtained >= 60)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success">Good Standing</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning">Needs Focus</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">Course enrollment records currently updating.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="pro-card p-4 h-100">
                <h5 class="fw-bold mb-3">My Faculty Mentor &amp; Advisory</h5>
                <div class="p-3 bg-light rounded-3 mb-3 border">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <div class="student-avatar" style="width:42px;height:42px;">FM</div>
                        <div>
                            <div class="fw-bold text-dark">@(string.IsNullOrEmpty(me.MentorName) ? "Department Faculty Advisor" : me.MentorName)</div>
                            <div class="text-muted small">Academic Mentor &bull; @me.Department</div>
                        </div>
                    </div>
                    <div class="text-muted small">
                        Assigned faculty mentor for semester advising, academic performance tracking, and coursework guidance.
                    </div>
                </div>

                <h6 class="fw-bold small text-uppercase text-muted mb-2">Personal Academic Summary</h6>
                <ul class="list-unstyled small text-muted mb-0">
                    <li class="mb-2">✔️ <strong>Attendance Status:</strong> @(me.AttendanceRate >= 75 ? "Eligible for semester end exams." : "Action required to reach 75% attendance.")</li>
                    <li class="mb-2">✔️ <strong>LMS Engagement:</strong> @me.LmsActivityHours hours recorded on the digital learning portal.</li>
                    <li class="mb-0">✔️ <strong>Continuous Risk Monitor:</strong> Evaluation generated via institutional predictive analytics.</li>
                </ul>
            </div>
        </div>
    </div>
}
else
{
    <!-- ========================================== -->
    <!-- FACULTY & ADMIN EXECUTIVE OVERVIEW         -->
    <!-- ========================================== -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="p-4 p-lg-5 pro-hero">
                <div class="d-flex flex-wrap justify-content-between align-items-center position-relative" style="z-index: 1;">
                    <div class="mb-3 mb-md-0">
                        <div class="d-inline-flex align-items-center bg-white bg-opacity-20 px-3 py-1 rounded-pill small mb-3">
                            <span class="badge bg-success rounded-circle p-1 me-2" style="width: 8px; height: 8px;"></span>
                            <span class="text-white fw-semibold">Continuous Early Warning Engine &bull; Academic Year 2026–27</span>
                        </div>
                        <h1 class="display-6 fw-bold mb-2">Academic Risk Radar</h1>
                        <p class="lead mb-0 text-white-50" style="max-width: 680px;">
                            Comprehensive student risk detection, multi-factor performance scoring, and automated mentoring workflows for university excellence.
                        </p>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Students" asp-action="Create" class="btn btn-light fw-bold px-4 py-2 rounded-3 shadow-sm">
                                + Add Student Record
                            </a>
                            <a asp-controller="Students" asp-action="Index" class="btn btn-outline-light fw-semibold px-4 py-2 rounded-3">
                                Student Directory &rarr;
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Register" class="btn btn-light fw-bold px-4 py-2 rounded-3 shadow-sm">
                                Register Account &rarr;
                            </a>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light fw-semibold px-4 py-2 rounded-3">
                                Institutional Sign In
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI Metric Cards Grid -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card pro-card-hover">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small text-uppercase fw-bold">Total Monitored Cohort</span>
                    <div class="kpi-icon-wrap bg-primary bg-opacity-10 text-primary">👥</div>
                </div>
                <div class="kpi-value text-dark mb-1">@total</div>
                <div class="d-flex align-items-center gap-2">
                    <span class="kpi-trend bg-success bg-opacity-10 text-success">Active Cohort</span>
                    <span class="text-muted small">All departments</span>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card pro-card-hover">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small text-uppercase fw-bold">At-Risk Students</span>
                    <div class="kpi-icon-wrap bg-danger bg-opacity-10 text-danger">⚠️</div>
                </div>
                <div class="kpi-value text-danger mb-1">@highRisk</div>
                <div class="d-flex align-items-center gap-2">
                    <span class="kpi-trend bg-danger bg-opacity-10 text-danger">Requires Action</span>
                    <span class="text-muted small">Score &ge; 50% threshold</span>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card pro-card-hover">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small text-uppercase fw-bold">Active Interventions</span>
                    <div class="kpi-icon-wrap bg-warning bg-opacity-10 text-warning">🛡️</div>
                </div>
                <div class="kpi-value text-dark mb-1">@interventions</div>
                <div class="d-flex align-items-center gap-2">
                    <span class="kpi-trend bg-warning bg-opacity-20 text-dark">In Progress</span>
                    <span class="text-muted small">Faculty mentoring</span>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card pro-card-hover">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small text-uppercase fw-bold">Engine Latency</span>
                    <div class="kpi-icon-wrap bg-info bg-opacity-10 text-info">⚡</div>
                </div>
                <div class="kpi-value text-dark mb-1">1.8 <span class="fs-5 text-muted fw-normal">ms</span></div>
                <div class="d-flex align-items-center gap-2">
                    <span class="kpi-trend bg-info bg-opacity-10 text-primary">Ultra-Fast</span>
                    <span class="text-muted small">Real-time scoring</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Middle Section: Visual Risk Radar & Priority Interventions -->
    <div class="row g-4 mb-4">
        <!-- Left: Cohort Distribution & Department Analytics -->
        <div class="col-lg-7">
            <div class="pro-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-1">Cohort Academic Risk Distribution</h5>
                        <p class="text-muted small mb-0">Multi-factor indicators: Attendance (35%), Assessments (30%), Coursework (20%), LMS (15%)</p>
                    </div>
                    <a asp-controller="RiskAnalysis" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        Engine Details &rarr;
                    </a>
                </div>

                <div class="risk-spectrum-wrap mb-4">
                    <div class="d-flex justify-content-between small text-muted mb-2">
                        <span><strong>Critical Risk</strong> (&ge;70%)</span>
                        <span class="text-danger fw-bold">1 Student (16.7%)</span>
                    </div>
                    <div class="progress-thin mb-3">
                        <div class="progress-bar bg-danger" style="width: 16.7%"></div>
                    </div>

                    <div class="d-flex justify-content-between small text-muted mb-2">
                        <span><strong>High Risk</strong> (50%–69%)</span>
                        <span class="text-warning fw-bold">2 Students (33.3%)</span>
                    </div>
                    <div class="progress-thin mb-3">
                        <div class="progress-bar bg-warning" style="width: 33.3%"></div>
                    </div>

                    <div class="d-flex justify-content-between small text-muted mb-2">
                        <span><strong>Moderate Risk</strong> (30%–49%)</span>
                        <span class="text-info fw-bold">1 Student (16.7%)</span>
                    </div>
                    <div class="progress-thin mb-3">
                        <div class="progress-bar bg-info" style="width: 16.7%"></div>
                    </div>

                    <div class="d-flex justify-content-between small text-muted mb-2">
                        <span><strong>Low Risk</strong> (&lt;30%)</span>
                        <span class="text-success fw-bold">2 Students (33.3%)</span>
                    </div>
                    <div class="progress-thin">
                        <div class="progress-bar bg-success" style="width: 33.3%"></div>
                    </div>
                </div>

                <!-- Department Risk Table -->
                <h6 class="fw-bold mb-2">Department Academic Health Matrix</h6>
                <div class="table-responsive">
                    <table class="table pro-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Department</th>
                                <th>Total Students</th>
                                <th>Avg Attendance</th>
                                <th>Avg Assessment</th>
                                <th>Health Standing</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>CSE</strong> (Computer Science)</td>
                                <td>3</td>
                                <td>79.5%</td>
                                <td>74.2%</td>
                                <td><span class="badge bg-success bg-opacity-10 text-success border border-success">Good Standings</span></td>
                            </tr>
                            <tr>
                                <td><strong>ECE</strong> (Electronics)</td>
                                <td>1</td>
                                <td>48.0%</td>
                                <td>42.0%</td>
                                <td><span class="badge bg-danger bg-opacity-10 text-danger border border-danger">Action Required</span></td>
                            </tr>
                            <tr>
                                <td><strong>IT</strong> (Information Tech)</td>
                                <td>1</td>
                                <td>72.5%</td>
                                <td>68.0%</td>
                                <td><span class="badge bg-warning bg-opacity-10 text-warning border border-warning">Monitoring</span></td>
                            </tr>
                            <tr>
                                <td><strong>MECH</strong> (Mechanical)</td>
                                <td>1</td>
                                <td>63.0%</td>
                                <td>58.0%</td>
                                <td><span class="badge bg-warning bg-opacity-10 text-warning border border-warning">Monitoring</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right: Priority Attention & Recent Interventions -->
        <div class="col-lg-5">
            <div class="pro-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Priority Attention Required</h5>
                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3">Top Alerts</span>
                </div>

                <!-- Alert Student 1 -->
                <div class="priority-alert-card mb-3 p-3 rounded-3 border-start border-4 border-danger bg-light">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <div>
                            <div class="fw-bold text-dark">Rohan Mehta</div>
                            <div class="text-muted small">ECE-2024-015 &bull; Semester 3</div>
                        </div>
                        <span class="risk-pill critical">Critical (79.4%)</span>
                    </div>
                    <div class="text-muted small mb-2">
                        Severe attendance deficit (48%) and internal assessment lag (42%). Formal notification dispatched.
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-controller="Students" asp-action="Details" asp-route-id="STU-003" class="btn btn-sm btn-danger rounded-pill px-3">
                            View Scorecard &rarr;
                        </a>
                        <span class="text-muted small align-self-center">+ Mentoring scheduled</span>
                    </div>
                </div>

                <!-- Alert Student 2 -->
                <div class="priority-alert-card p-3 rounded-3 border-start border-4 border-warning bg-light">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <div>
                            <div class="fw-bold text-dark">Aarav Sharma</div>
                            <div class="text-muted small">CSE-2024-001 &bull; Semester 5</div>
                        </div>
                        <span class="risk-pill high">High (67.5%)</span>
                    </div>
                    <div class="text-muted small mb-2">
                        Attendance dropping across Database Systems (56%) and OS (60%). Peer tutoring assigned.
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-controller="Students" asp-action="Details" asp-route-id="STU-001" class="btn btn-sm btn-warning rounded-pill px-3">
                            View Scorecard &rarr;
                        </a>
                        <span class="text-muted small align-self-center">+ Peer tutoring active</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
